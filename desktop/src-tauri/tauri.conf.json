{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChitChat",
  "version": "0.1.2",
  "identifier": "org.chitchat.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "beforeBuildCommand": "npm --prefix ../web run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "deb",
      "appimage",
      "dmg"
    ],
    "category": "SocialNetworking",
    "shortDescription": "ChitChat: a place for your people, hosted by you",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "template": "windows/installer.nsi"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNEQjhEQzkwMjY0OERFODUKUldTRjNrZ21rTnk0UFRNNVlmSEFDSjc2MHBrcHRNZTBKRXV1WGlaUC92OW9jZ3JTaE5RLzQrOHMK",
      "endpoints": [
        "https://github.com/pippopippo233333/chitchat/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
